# 复制成 .env（已 gitignore，不要提交），docker compose 会自动读它。
#
# 全都是可选的：什么都不设 docker compose up -d 也能跑起来，Ice 口令会在容器
# 启动时随机生成。刻意不给默认口令——一个能用的默认口令永远不会被改，而且会
# 跟着仓库到处走。

# SuperUser 密码。第一次部署设一次就行，之后可以删掉：它存在挂出来的数据库
# 里，不在镜像里。留空 = 不动数据库里已有的那个。
MUMBLE_SUPERUSER_PASSWORD=

# Murmur 的 Ice 写口令。留空的话 start.sh 每次启动随机生成一个写进
# mumble-server.ini，login.py 自己会去那儿读，等于零配置。
MUMBLE_ICE_SECRET=

# 用别处构建的镜像时改这一行，比如回滚到某个 commit：
#   SERVER_IMAGE=ghcr.io/jianyuelab-org/airwaysn_audio-server:sha-abc1234
SERVER_IMAGE=

# 下面两个只有跑通播机队时才要（docker compose --profile atis up -d）。
# 注意 login.py 里的保留账号旁路已经去掉了，这个 cid 得在 can-web 那边真实存在。
ATIS_CID=900
ATIS_PASSWORD=
ATIS_RANGE_NM=100
ATIS_DATAFEED_URL=https://data.ceruleanavi.net/v1/data.json
